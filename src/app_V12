def render_share_competitive(
    df_full: pd.DataFrame,
    applied_regions: list,
    applied_countries: list,
    applied_powertrains: list,
    applied_oems: list,
    applied_brands: list,          # NEW
    compare_mode: str,             # NEW: "oem" or "brand"
    applied_month_range: tuple | None,
    region_map: dict,
    top_n: int = 10
):
    if df_full.empty:
        st.warning("No market data available for the selected scope.")
        return

    # ---- geo scope ------------------------------------------------------
    all_region_names = set(region_map.keys())
    def is_global(regions, countries) -> bool:
        sel_regions = set(regions or [])
        return (not countries) and (len(sel_regions) == 0 or sel_regions == all_region_names)

    scope = df_full.copy()
    if applied_countries:
        _countries = expand_countries_for_filter(applied_countries, country_expansion_map)
        scope = scope[scope["country"].isin(_countries)]
    elif applied_regions and not is_global(applied_regions, applied_countries):
        allowed = sorted({c for r in applied_regions for c in region_map.get(r, [])})
        scope = scope[scope["country"].isin(allowed)]

    # Month range (monthly everywhere)
    if applied_month_range:
        s, e = applied_month_range
        scope = scope[(scope["yyyymm"].astype(str) >= str(s)) & (scope["yyyymm"].astype(str) <= str(e))]
    single_month = bool(applied_month_range and applied_month_range[0] == applied_month_range[1])

    # Powertrain filter on both numerator & denominator
    chosen_pts = [p for p in (applied_powertrains or []) if str(p).strip()]
    if chosen_pts:
        scope = scope[scope["powertrain_simplified"].isin(chosen_pts)]

    # Hard trim to real last available month
    scope = trim_to_latest(scope)
    if scope.empty:
        st.warning("No market data available for the selected scope.")
        return

    # ---- choose entity dimension & labels --------------------------------
    entity_col   = "group_standardized" if compare_mode == "oem" else "maker_brand"
    entity_label = "OEM" if compare_mode == "oem" else "Brand"

    # If comparing brands and OEM(s) are selected, constrain brands to those OEMs
    if compare_mode == "brand" and applied_oems:
        scope = scope[scope["group_standardized"].isin(applied_oems)]

    # ---- monthly entity units & market totals ----------------------------
    monthly_ent = scope.groupby(["year", "month", entity_col], as_index=False)["total_sales"].sum()
    max_cut = latest_available_yyyymm(scope)
    monthly_ent = _redistribute_period_totals_monthly(monthly_ent, [entity_col], "total_sales", max_yyyymm=max_cut)

    monthly_ent = monthly_ent.assign(
        period_dt=pd.to_datetime(
            monthly_ent["year"].astype(str) + monthly_ent["month"].astype(str).str.zfill(2),
            format="%Y%m"
        )
    )
    monthly_market = (
        monthly_ent.groupby(["year", "month"], as_index=False)["total_sales"].sum()
                   .rename(columns={"total_sales": "market_total"})
    )
    shares = (
        monthly_ent.merge(monthly_market, on=["year", "month"], how="left")
                   .assign(share=lambda d: np.where(d["market_total"] > 0, d["total_sales"] / d["market_total"], np.nan))
    )

    # ---- keep list logic (OEM or Brand) ----------------------------------
    totals = shares.groupby(entity_col)["total_sales"].sum().sort_values(ascending=False)

    if compare_mode == "oem":
        if applied_oems and len(applied_oems) >= 2:
            keep = [o for o in applied_oems if o in totals.index]
        elif applied_oems and len(applied_oems) == 1:
            sel = [o for o in applied_oems if o in totals.index]
            others = [o for o in totals.index if o not in sel][:max(0, top_n - 1)]
            keep = sel + others
        else:
            keep = list(totals.index[:top_n])
    else:
        if applied_brands and len(applied_brands) >= 2:
            keep = [b for b in applied_brands if b in totals.index]
        elif applied_brands and len(applied_brands) == 1:
            sel = [b for b in applied_brands if b in totals.index]
            others = [b for b in totals.index if b not in sel][:max(0, top_n - 1)]
            keep = sel + others
        else:
            keep = list(totals.index[:top_n])

    if not keep:
        st.info(f"No {entity_label.lower()}s to display in the selected scope.")
        return

    # Colors/order
    seg_order = keep.copy()
    PALETTE = px.colors.qualitative.Plotly
    color_map = {seg: PALETTE[i % len(PALETTE)] for i, seg in enumerate(seg_order)}
    OTHER_COLOR = "#B0B0B0"

    global_flag = is_global(applied_regions, applied_countries)

    # ---------------------------- MULTI-MONTH ----------------------------
    if not single_month:
        # 1) Line chart (NEVER show 'Other' lines)
        line_df = shares[shares[entity_col].isin(keep)].dropna(subset=["share"]).sort_values("period_dt")
        if not line_df.empty:
            eff_win = _effective_ma_win(applied_ma_window, applied_month_range)
            data_for_line = line_df.sort_values("period_dt").copy()
            y_col = "share"
            if eff_win:
                data_for_line = apply_trailing_ma(
                    data_for_line, group_cols=[entity_col], date_col="period_dt",
                    value_col="share", window=eff_win
                )
                y_col = "share_ma"

            fig_line = px.line(
                data_for_line,
                x="period_dt", y=y_col, color=entity_col,
                color_discrete_map=color_map, category_orders={entity_col: seg_order},
                template="plotly_white",
                labels={y_col: _ylabel(y_col), "period_dt":"Month", entity_col: entity_label},
                title=make_title(
                    f"Competitive Market Share by {entity_label}",
                    applied_oems=applied_oems if compare_mode == "oem" else [],
                    applied_brands=applied_brands if compare_mode == "brand" else [],
                    applied_regions=[] if global_flag else applied_regions,
                    applied_countries=applied_countries,
                    region_map=region_map,
                    applied_month_range=applied_month_range,
                    powertrains=chosen_pts or None,
                    where_override="Global" if global_flag else None,
                    ma_window=eff_win,
                ),
                custom_data=["total_sales","market_total"]
            )
            # unified hover showing OEM/Brand units + Market units
            fig_line.update_traces(
                hovertemplate=("Month: %{x|%m/%Y}<br>%{fullData.name}: %{y:.1%}"
                               "<br>Units: %{customdata[0]:,.0f}"
                               "<br>Market Units: %{customdata[1]:,.0f}<extra></extra>")
            )
            fig_line.update_yaxes(tickformat=".0%")
            fig_line.update_xaxes(tickformat="%m/%Y")
            fig_line.update_layout(legend=dict(title="", orientation="h", yanchor="bottom", y=1.12, xanchor="right", x=1))
            st.plotly_chart(_style_fig(fig_line), use_container_width=True)

        # 2) Δ Share bar (include 'Other' to close to 100%)
        view = shares.dropna(subset=["share"]).copy()
        if view.empty:
            st.info("No share data available for Δ chart.")
            return
        start_dt, end_dt = view["period_dt"].min(), view["period_dt"].max()

        mask_start = (view["period_dt"] == start_dt) & (view[entity_col].isin(keep))
        mask_end   = (view["period_dt"] == end_dt)   & (view[entity_col].isin(keep))

        st_sh = (
            view.loc[mask_start]
                .groupby(entity_col, as_index=False)["share"].sum()
                .rename(columns={"share": "share_start"})
        )
        en_sh = (
            view.loc[mask_end]
                .groupby(entity_col, as_index=False)["share"].sum()
                .rename(columns={"share": "share_end"})
        )

        # Ensure all kept are present (fill missing with 0 share)
        st_sh = st_sh.set_index(entity_col).reindex(keep).fillna(0.0).reset_index()
        en_sh = en_sh.set_index(entity_col).reindex(keep).fillna(0.0).reset_index()

        delta = (st_sh.merge(en_sh, on=entity_col)
                      .assign(delta=lambda d: d["share_end"] - d["share_start"]))

        # Add "Other" as the complement for both endpoints
        other_start = float(1.0 - st_sh["share_start"].sum())
        other_end   = float(1.0 - en_sh["share_end"].sum())
        delta = pd.concat([
            delta,
            pd.DataFrame({entity_col:["Other"], "share_start":[other_start], "share_end":[other_end], "delta":[other_end - other_start]})
        ], ignore_index=True)

        delta["delta_sign"] = np.where(delta["delta"] >= 0, "Positive", "Negative")
        delta["delta_pp"] = (delta["delta"] * 100.0).round(2)
        delta["delta_pp"] = delta["delta_pp"].where(delta["delta_pp"].abs() >= 1e-3, 0.0)
        delta["delta_pp_lbl"] = delta["delta_pp"].map(lambda v: f"{v:+.2f} pp")

        tick_vals, tick_text, x_range_pp = _nice_pp_axis(delta["delta_pp"])

        fig_delta = px.bar(
            delta, x="delta_pp", y=entity_col, orientation="h",
            color="delta_sign", color_discrete_map=SIGN_COLORS,
            template="plotly_white",
            labels={"delta_pp": "Change in Share (pp)", entity_col: entity_label, "delta_sign": ""},
            title=make_title(
                f"Change in Market Share by {entity_label} (first→last)",
                applied_oems=applied_oems if compare_mode == "oem" else [],
                applied_brands=applied_brands if compare_mode == "brand" else [],
                applied_regions=[] if global_flag else applied_regions,
                applied_countries=applied_countries,
                region_map=region_map,
                applied_month_range=applied_month_range,
                powertrains=chosen_pts or None,
                where_override="Global" if global_flag else None,
            ),
            text="delta_pp_lbl"
        )
        fig_delta.update_traces(
            texttemplate="%{text}",
            textposition="outside",
            hovertemplate="%{y}<br>Δ share: %{x:+.2f} pp<extra></extra>",
            cliponaxis=False,
        )
        fig_delta.update_layout(
            yaxis=dict(categoryorder="total ascending"),
            legend=dict(title="", orientation="h", yanchor="bottom", y=1.08, xanchor="right", x=1),
            margin=dict(l=110, r=30, t=70, b=40)
        )
        fig_delta.update_xaxes(
            tickmode="array",
            tickvals=tick_vals,
            ticktext=tick_text,
            range=x_range_pp,
            zeroline=True,
            tickangle=0,
        )
        st.plotly_chart(_style_fig(fig_delta), use_container_width=True)

    # ---------------------------- SINGLE MONTH ---------------------------
    else:
        sel = int(applied_month_range[0])
        sel_y, sel_m = sel // 100, sel % 100
        one = shares[(shares["year"] == sel_y) & (shares["month"] == sel_m)].copy()
        if one.empty:
            st.info("No data for the selected month.")
            return

        # Keep chosen/top logic, then add "Other" to make 100%
        show = (one[one[entity_col].isin(keep)]
                   .groupby(entity_col, as_index=False)[["share","total_sales"]].sum())

        other_share = 1.0 - float(show["share"].sum())
        other_units = float(one["total_sales"].sum() - show["total_sales"].sum())
        show = pd.concat([
            show,
            pd.DataFrame({entity_col:["Other"], "share":[max(0.0, other_share)], "total_sales":[max(0.0, other_units)]})
        ], ignore_index=True)

        # Colors (add grey for Other)
        pie_colors = color_map.copy()
        pie_colors["Other"] = OTHER_COLOR
        order = [o for o in keep] + ["Other"]
        show[entity_col] = pd.Categorical(show[entity_col], categories=order, ordered=True)
        show = show.sort_values(entity_col)

        fig_pie = px.pie(
            show, names=entity_col, values="share",
            color=entity_col, color_discrete_map=pie_colors,
            template="plotly_white",
            title=make_title(
                f"Market Share by {entity_label} (Competitive)",
                applied_oems=applied_oems if compare_mode == "oem" else [],
                applied_brands=applied_brands if compare_mode == "brand" else [],
                applied_regions=[] if is_global(applied_regions, applied_countries) else applied_regions,
                applied_countries=applied_countries,
                region_map=region_map,
                applied_month_range=(str(sel), str(sel)),
                powertrains=chosen_pts or None,
                where_override="Global" if is_global(applied_regions, applied_countries) else None,
            )
        )
        fig_pie.update_traces(sort=False, texttemplate="%{label}<br>%{percent:.1%}")
        fig_pie.update_layout(
            legend=dict(
                orientation="v",
                yanchor="middle",
                y=0.5,
                xanchor="left",
                x=1.02
            )
        )
