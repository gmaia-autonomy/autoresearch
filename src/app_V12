# ----------- Moving average helpers -----------

def month_span_len(applied_month_range: tuple[str,str] | None) -> int:
    """Inclusive count of months in ('YYYYMM','YYYYMM')."""
    if not applied_month_range: 
        return 0
    s, e = map(int, applied_month_range)
    sy, sm = divmod(s, 100); ey, em = divmod(e, 100)
    return (ey - sy) * 12 + (em - sm) + 1

def apply_trailing_ma(
    df: pd.DataFrame,
    *,
    group_cols: list[str],
    date_col: str,
    value_col: str,
    window: int
) -> pd.DataFrame:
    """
    Strict trailing MA: include current month, require full window (min_periods=window).
    Adds f"{value_col}_ma" aligned with the original rows.
    Handles categoricals with unused categories to avoid empty-group rolling errors.
    """
    if not window or window < 2 or df.empty:
        out = df.copy()
        out[f"{value_col}_ma"] = np.nan
        return out

    out = df.copy()

    # 1) Drop unused categories on all grouping cols (prevents empty groups)
    for c in group_cols:
        if c in out.columns and pd.api.types.is_categorical_dtype(out[c]):
            out[c] = out[c].cat.remove_unused_categories()

    # 2) Sort for stable rolling
    out = out.sort_values(group_cols + [date_col])

    # 3) Safe rolling (guard s.empty)
    def _safe_roll(s: pd.Series) -> pd.Series:
        if s.empty:
            return pd.Series(np.nan, index=s.index)
        return s.rolling(window=window, min_periods=window).mean()

    # 4) observed=True avoids empty categorical groups entirely
    out[f"{value_col}_ma"] = (
        out.groupby(group_cols, observed=True, group_keys=False)[value_col]
           .transform(_safe_roll)
    )
    return out

def first_common_valid_ma(df: pd.DataFrame, *, group_col: str, date_col: str, value_ma_col: str) -> pd.DataFrame:
    """
    For stacked bars: start where ALL series have a valid MA.
    Returns df filtered to >= max(first_valid_index per series).
    """
    if df.empty: 
        return df
    firsts = (
        df.dropna(subset=[value_ma_col])
          .groupby(group_col)[date_col].min()
    )
    if firsts.empty or len(firsts) == 0:
        return df.iloc[0:0]
    common_start = firsts.max()
    return df[df[date_col] >= common_start].copy()

def smoothing_suffix(n: int | None) -> str:
    return "" if not n or n < 2 else f"{n}-Month Moving Average"

def _effective_ma_win(applied_ma_window, applied_month_range) -> int | None:
    """
    Global rule:
    - Single-month -> raw
    - If selected span < N -> raw + yellow note
    - Else -> N
    """
    if not applied_ma_window:
        return None
    # single-month always raw
    if applied_month_range and applied_month_range[0] == applied_month_range[1]:
        show_warning_black(f"Need at least {int(applied_ma_window)} months for the selected smoothing.")
        return None
    need = int(applied_ma_window)
    have = month_span_len(applied_month_range)
    if have < need:
        show_warning_black(f"Need at least {need} months for the selected smoothing.")
        return None
    return need

def _ylabel(col: str) -> str:
    """Friendly y-axis label for sales/share, including moving averages."""
    if col.startswith("share"):
        return "Market Share"
    if col.startswith("total_sales"):
        return "Sales"
    return col

def _nice_pp_axis(values, *, target_ticks=8):
    """
    Build nice tick values/text and a padded symmetric range for 'percentage-point' axes.
    values: iterable of numeric values in **pp** (not fractions).
    """
    import pandas as pd
    s = pd.Series(values, dtype="float64").fillna(0.0)
    # kill microscopic noise so we don't get -0.00 or 8.88e-17
    s = s.where(s.abs() >= 1e-3, 0.0)

    span_max = float(s.abs().max()) or 0.1
    full_span = span_max * 2
    raw_step = full_span / max(3, target_ticks)

    def _nice_step(x: float) -> float:
        if x <= 0:
            return 0.1
        exp = math.floor(math.log10(x))
        frac = x / (10 ** exp)
        for n in (1, 2, 2.5, 5, 10):
            if frac <= n:
                return n * (10 ** exp)
        return 10 ** (exp + 1)

    step = _nice_step(raw_step)
    n_side = int(math.ceil(span_max / step))
    tick_vals = [round(i * step, 10) for i in range(-n_side, n_side + 1)]
    tick_fmt = "{:+.1f}" if step < 1 else "{:+.0f}"
    tick_text = [tick_fmt.format(v) for v in tick_vals]

    pad = max(0.2 * step, 0.06 * full_span)
    x_range = [tick_vals[0] - pad, tick_vals[-1] + pad]
    return tick_vals, tick_text, x_range




