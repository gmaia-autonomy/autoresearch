def _render_sales_internal_market_fallback(
    final_df: pd.DataFrame,
    applied_regions: list,
    applied_countries: list,
    region_map: dict,
    country_to_region: dict,
    applied_month_range: tuple | None,
    applied_powertrains: list | None,
):
    """
    Fallback shown *under* the warning when 'Sales — Internal' has no OEM selected.
    - Multi-month: line chart of market sales by Region (or by Country if exactly one region selected)
    - Single-month: pie of market sales by Region (or by Country within that region)
    - Respects month range and any selected powertrain(s)
    """
    if final_df.empty:
        st.info("No market data available for the selected scope.")
        return

    # Respect powertrains (final_df is usually already filtered, but this is safe)
    pts = [p for p in (applied_powertrains or []) if str(p).strip()]
    scope = final_df.copy()
    if pts:
        scope = scope[scope["powertrain_simplified"].isin(pts)]

    # Map countries → regions early
    scope = scope.copy()
    scope["region"] = scope["country"].map(country_to_region)

    # Decide segmentation
    single_month = False
    if applied_month_range and len(applied_month_range) == 2:
        sm, em = applied_month_range
        single_month = (sm == em)

    if len(applied_regions) == 1:
        # Segment = countries within the selected region
        target_region = applied_regions[0]
        allowed_countries = set(region_map.get(target_region, []))
        scope = scope[scope["country"].isin(allowed_countries)]
        seg_col = "country"

        # Top-10 + 'Other' (include any user-picked countries)
        keep = choose_top_segments_with_inclusions(scope, "country", n=10, inclusions=applied_countries)
        scope = scope.assign(seg=np.where(scope["country"].isin(keep), scope["country"], "Other"))
        plot_seg = "seg"
        color_map = {s: px.colors.qualitative.Plotly[i % 10] for i, s in enumerate(sorted(set(scope[plot_seg])))}
        if "Other" in color_map:
            color_map["Other"] = "#B0B0B0"

        where_override = None  # title should show the region name
        title_geo_regions = [target_region]
    else:
        # Segment = regions (global or multi-region)
        scope = scope.dropna(subset=["region"])
        if applied_regions:
            scope = scope[scope["region"].isin(applied_regions)]
        seg_col = "region"
        plot_seg = "region"
        # Fixed region palette with fallbacks
        base = px.colors.qualitative.Plotly
        regions_present = scope["region"].dropna().unique().tolist()
        color_map = {r: REGION_COLORS.get(r, base[i % len(base)]) for i, r in enumerate(regions_present)}
        where_override = "Global" if (not applied_regions or len(applied_regions) == len(region_map)) else None
        title_geo_regions = [] if where_override else applied_regions

    if scope.empty:
        st.info("No market data available for the selected geography.")
        return

    # Aggregate monthly totals by segment
    monthly = scope.groupby(["year", "month", plot_seg], as_index=False)["total_sales"].sum()

    # Cap/normalize monthly cadence; align common last month across segments
    max_cut = latest_available_yyyymm(scope)
    monthly = _redistribute_period_totals_monthly(monthly, [plot_seg], "total_sales", max_yyyymm=max_cut)

    # Align series to a common last valid month (prevents trailing zeros)
    _cut_df = monthly.rename(columns={plot_seg: "series"})
    cutoff = common_series_cutoff(_cut_df, "series", "total_sales")
    if cutoff:
        monthly = monthly[_yyyymm(monthly["year"], monthly["month"]) <= cutoff]

    if monthly.empty:
        st.info("No market data to plot after alignment.")
        return

    # Order segments by total, 'Other' last if present
    seg_totals = monthly.groupby(plot_seg)["total_sales"].sum().sort_values(ascending=False)
    segments = order_other_last(seg_totals.index.tolist())
    monthly[plot_seg] = pd.Categorical(monthly[plot_seg], categories=segments, ordered=True)

    # Build datetime axis
    monthly = monthly.assign(
        period_dt=pd.to_datetime(monthly["year"].astype(str) + monthly["month"].astype(str).str.zfill(2), format="%Y%m")
    ).sort_values(["period_dt", plot_seg])

    # ----- PLOTS -----
    if single_month:
        sel = int(applied_month_range[0])
        sel_y, sel_m = sel // 100, sel % 100
        one = monthly[(monthly["year"] == sel_y) & (monthly["month"] == sel_m)].copy()
        if one.empty:
            st.info("No data for the selected month.")
            return
        one = one.groupby(plot_seg, as_index=False)["total_sales"].sum()
        one[plot_seg] = pd.Categorical(one[plot_seg], categories=segments, ordered=True)
        one = one.sort_values("total_sales", ascending=False)

        # PIE (share by segment)
        fig_pie = px.pie(
            one,
            names=plot_seg, values="total_sales",
            color=plot_seg, color_discrete_map=color_map,
            category_orders={plot_seg: segments},
            title=make_title(
                f"Sales Share by {('Country' if plot_seg != 'region' else 'Region')}",
                applied_oems=[], applied_brands=[],
                applied_regions=title_geo_regions, applied_countries=[],
                region_map=region_map,
                applied_month_range=(str(sel), str(sel)),
                powertrains=pts or None,
                where_override=where_override,
            ),
            template="plotly_white"
        )
        fig_pie.update_layout(
            legend=dict(orientation="v", yanchor="middle", y=0.5, xanchor="left", x=1.02)
        )
        st.plotly_chart(_style_fig(fig_pie, pie=True), use_container_width=True)
    else:
        # LINE (units by segment over time), optional MA consistent with the rest of the app
        eff_win = _effective_ma_win(applied_ma_window, applied_month_range)
        view = monthly.copy()
        y_col = "total_sales"
        if eff_win:
            view = apply_trailing_ma(
                view, group_cols=[plot_seg], date_col="period_dt",
                value_col="total_sales", window=eff_win
            )
            # start where all series have valid MA to avoid staggered starts
            view = first_common_valid_ma(view, group_col=plot_seg, date_col="period_dt", value_ma_col="total_sales_ma")
            y_col = "total_sales_ma"

        fig_line = px.line(
            view,
            x="period_dt", y=y_col, color=plot_seg,
            color_discrete_map=color_map, category_orders={plot_seg: segments},
            template="plotly_white",
            labels={y_col: _ylabel(y_col), "period_dt": "Month", plot_seg: (plot_seg.title())},
            title=make_title(
                f"Sales by {('Country' if plot_seg != 'region' else 'Region')}",
                applied_oems=[], applied_brands=[],
                applied_regions=title_geo_regions, applied_countries=[],
                region_map=region_map,
                applied_month_range=applied_month_range,
                powertrains=pts or None,
                where_override=where_override,
                ma_window=eff_win,
            ),
            custom_data=["total_sales"]
        )
        if eff_win:
            fig_line.update_traces(
                hovertemplate="Month: %{x|%m/%Y}<br>Smoothed: %{y:,.0f}<br>Actual: %{customdata[0]:,.0f}<extra></extra>"
            )
        else:
            fig_line.update_traces(
                hovertemplate="Month: %{x|%m/%Y}<br>Units: %{y:,.0f}<extra></extra>"
            )
        fig_line.update_layout(
            yaxis=dict(tickformat=","), legend=dict(title="", orientation="h", yanchor="bottom", y=1.12, xanchor="right", x=1)
        )
        fig_line.update_xaxes(tickformat="%m/%Y")
        st.plotly_chart(_style_fig(fig_line), use_container_width=True)



