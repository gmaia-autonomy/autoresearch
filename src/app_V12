# ====================================================================== Powertrain Penetration ======================================================================

def render_pt_penetration(
    df_full: pd.DataFrame,
    applied_regions: list,
    applied_countries: list,
    region_map: dict,
    country_to_region: dict,
    applied_month_range: tuple | None,
    applied_powertrains: list | None,
):
    """
    Powertrain Penetration (share of chosen PT(s) in total market) as a line chart.
    • None/All regions -> lines = each region + GLOBAL
    • One region       -> lines = up to Top-10 countries in that region + Region aggregate (skip for China)
    • Multiple regions -> lines = only those regions (no Global)
    • PT selection required; multiple PTs are combined in numerator
    """
    # ---- guard: at least one PT ----
    chosen_pts = [p for p in (applied_powertrains or []) if str(p).strip()]
    if not chosen_pts:
        show_warning_black("At least one powertrain must be selected for this function. Please select a powertrain.")
        return

    # ---- month range (required) ----
    if not applied_month_range:
        st.warning("Please pick a month range.")
        return
    s_yyyymm, e_yyyymm = map(str, applied_month_range)

    # Build scope: ignore OEM/Brand by design; only month window
    scope = df_full[(df_full["yyyymm"].astype(str) >= s_yyyymm) & (df_full["yyyymm"].astype(str) <= e_yyyymm)].copy()

    # Hard trim to last real month based on the market (denominator)
    scope = trim_to_latest(scope)
    if scope.empty:
        st.warning("No data available for the selected window.")
        return

    # Helpers
    all_regions = list(region_map.keys())
    none_or_all = (not applied_regions) or (len(applied_regions) == len(all_regions))
    one_region  = (applied_regions is not None and len(applied_regions) == 1)
    multi       = (applied_regions is not None and len(applied_regions) > 1 and not none_or_all)

    # Moving average window
    eff_win = _effective_ma_win(applied_ma_window, applied_month_range)

    # ---------- CASE A: None/All Regions  → Regions + Global ----------
    if none_or_all:
        dfA = scope.copy()
        dfA["region"] = dfA["country"].map(country_to_region)
        dfA = dfA.dropna(subset=["region"])

        # Monthly market totals (denominator) by region
        den_reg = dfA.groupby(["year","month","region"], as_index=False)["total_sales"].sum()
        max_cut = latest_available_yyyymm(dfA)
        den_reg = _redistribute_period_totals_monthly(den_reg, ["region"], "total_sales", max_yyyymm=max_cut)

        # Numerator: chosen PT(s) only
        num_reg = dfA[dfA["powertrain_simplified"].isin(chosen_pts)]
        num_reg = num_reg.groupby(["year","month","region"], as_index=False)["total_sales"].sum()
        num_reg = _redistribute_period_totals_monthly(num_reg, ["region"], "total_sales", max_yyyymm=max_cut)

        # Merge + share
        reg = (den_reg.rename(columns={"total_sales":"den"})
                     .merge(num_reg.rename(columns={"total_sales":"num"}), on=["year","month","region"], how="left")
                     .fillna({"num":0.0}))
        reg["share"] = np.where(reg["den"]>0, reg["num"]/reg["den"], np.nan)
        reg["series"] = reg["region"]

        # Global line
        den_glb = dfA.groupby(["year","month"], as_index=False)["total_sales"].sum()
        den_glb = _redistribute_period_totals_monthly(den_glb, [], "total_sales", max_yyyymm=max_cut)
        num_glb = dfA[dfA["powertrain_simplified"].isin(chosen_pts)].groupby(["year","month"], as_index=False)["total_sales"].sum()
        num_glb = _redistribute_period_totals_monthly(num_glb, [], "total_sales", max_yyyymm=max_cut)

        glb = (den_glb.rename(columns={"total_sales":"den"})
                      .merge(num_glb.rename(columns={"total_sales":"num"}), on=["year","month"], how="left")
                      .fillna({"num":0.0}))
        glb["share"] = np.where(glb["den"]>0, glb["num"]/glb["den"], np.nan)
        glb["series"] = "Global"

        monthly = pd.concat([
            reg[["year","month","series","num","den","share"]],
            glb[["year","month","series","num","den","share"]]
        ], ignore_index=True)

        # common last month where den>0 per series
        tmp = monthly.loc[monthly["den"]>0].copy()
        tmp["yyyymm_int"] = _yyyymm(tmp["year"], tmp["month"])
        last_per = tmp.groupby("series")["yyyymm_int"].max()
        if not last_per.empty:
            common_last = int(last_per.min())
            monthly = monthly[_yyyymm(monthly["year"], monthly["month"]) <= common_last]

        if monthly.empty:
            st.info("No penetration data for the selected window.")
            return

        # Datetime + ordering + colors
        monthly = monthly.assign(period_dt=pd.to_datetime(monthly["year"].astype(str)+monthly["month"].astype(str).str.zfill(2), format="%Y%m"))
        segs = [r for r in all_regions if r in monthly["series"].unique().tolist()] + (["Global"] if "Global" in monthly["series"].unique() else [])
        monthly["series"] = pd.Categorical(monthly["series"], categories=segs, ordered=True)
        palette = {s: (REGION_COLORS.get(s) if s!="Global" else "#111111") for s in segs}

        # Moving average (optional)
        y_col = "share"
        view = monthly.sort_values(["period_dt","series"]).copy()
        if eff_win:
            view = apply_trailing_ma(view, group_cols=["series"], date_col="period_dt", value_col="share", window=eff_win)
            y_col = "share_ma"

        fig = px.line(
            view, x="period_dt", y=y_col, color="series",
            color_discrete_map=palette, category_orders={"series": segs},
            template="plotly_white",
            labels={y_col:"Penetration", "period_dt":"Month", "series":"Region"},
            title=make_title(
                "Powertrain Penetration",
                applied_oems=[], applied_brands=[],
                applied_regions=[], applied_countries=[],
                region_map=region_map,
                applied_month_range=applied_month_range,
                powertrains=chosen_pts,
                where_override="Global",
                ma_window=eff_win,
            ),
            custom_data=["share","num","den"]
        )
        if eff_win:
            fig.update_traces(hovertemplate="Month: %{x|%m/%Y}<br>Smoothed: %{y:.1%}<br>Actual: %{customdata[0]:.1%}<br>PT Units: %{customdata[1]:,.0f}<br>Market Units: %{customdata[2]:,.0f}<extra></extra>")
        else:
            fig.update_traces(hovertemplate="Month: %{x|%m/%Y}<br>Penetration: %{y:.1%}<br>PT Units: %{customdata[1]:,.0f}<br>Market Units: %{customdata[2]:,.0f}<extra></extra>")
        fig.update_yaxes(tickformat=".0%")
        fig.update_xaxes(tickformat="%m/%Y")
        fig.update_layout(legend=dict(title="", orientation="h", yanchor="bottom", y=1.12, xanchor="right", x=1))
        st.plotly_chart(_style_fig(fig), use_container_width=True)
        return

    # ---------- CASE B: One Region  → Countries (+ Region aggregate unless China) ----------
    if one_region:
        reg = applied_regions[0]
        region_countries = region_map.get(reg, [])
        dfB = scope[scope["country"].isin(region_countries)].copy()
        if dfB.empty:
            st.info("No data for the selected region.")
            return

        # Denominator/Numerator by country
        den_cty = dfB.groupby(["year","month","country"], as_index=False)["total_sales"].sum()
        max_cut = latest_available_yyyymm(dfB)
        den_cty = _redistribute_period_totals_monthly(den_cty, ["country"], "total_sales", max_yyyymm=max_cut)

        num_cty = dfB[dfB["powertrain_simplified"].isin(chosen_pts)].groupby(["year","month","country"], as_index=False)["total_sales"].sum()
        num_cty = _redistribute_period_totals_monthly(num_cty, ["country"], "total_sales", max_yyyymm=max_cut)

        cty = (den_cty.rename(columns={"total_sales":"den"})
                      .merge(num_cty.rename(columns={"total_sales":"num"}), on=["year","month","country"], how="left")
                      .fillna({"num":0.0}))
        cty["share"] = np.where(cty["den"]>0, cty["num"]/cty["den"], np.nan)
        cty = cty.rename(columns={"country":"series"})

        # Region aggregate (skip if China region == single country)
        if not (reg == "China" and len(region_countries) == 1 and region_countries[0] == "China"):
            den_reg = dfB.groupby(["year","month"], as_index=False)["total_sales"].sum()
            den_reg = _redistribute_period_totals_monthly(den_reg, [], "total_sales", max_yyyymm=max_cut)
            num_reg = dfB[dfB["powertrain_simplified"].isin(chosen_pts)].groupby(["year","month"], as_index=False)["total_sales"].sum()
            num_reg = _redistribute_period_totals_monthly(num_reg, [], "total_sales", max_yyyymm=max_cut)
            reg_line = (den_reg.rename(columns={"total_sales":"den"})
                               .merge(num_reg.rename(columns={"total_sales":"num"}), on=["year","month"], how="left")
                               .fillna({"num":0.0}))
            reg_line["share"] = np.where(reg_line["den"]>0, reg_line["num"]/reg_line["den"], np.nan)
            reg_line["series"] = reg
            cty = pd.concat([cty, reg_line[["year","month","series","num","den","share"]]], ignore_index=True)

        # Align common last month
        tmp = cty.loc[cty["den"]>0].copy()
        tmp["yyyymm_int"] = _yyyymm(tmp["year"], tmp["month"])
        last_per = tmp.groupby("series")["yyyymm_int"].max()
        if not last_per.empty:
            common_last = int(last_per.min())
            cty = cty[_yyyymm(cty["year"], cty["month"]) <= common_last]

        if cty.empty:
            st.info("No penetration data for the selected window.")
            return

        # Top-10 countries (by total denominator over the window), always include any user-picked countries
        totals = cty[cty["series"] != reg].groupby("series")["den"].sum().sort_values(ascending=False)
        keep = choose_top_segments_with_inclusions(
            df_scope=cty[cty["series"] != reg].rename(columns={"den":"total_sales"}),
            segment_col="series", n=10, inclusions=applied_countries
        )
        # Add region aggregate back if present
        if reg in cty["series"].unique() and reg not in keep:
            keep = keep[:9] + [reg]  # cap total ~10 when region line is added

        show = cty[cty["series"].isin(keep + ([reg] if reg in cty["series"].unique() else []))].copy()

        # Datetime + ordering + colors  (dedup & existence-safe)
        show = show.assign(
            period_dt=pd.to_datetime(
                show["year"].astype(str) + show["month"].astype(str).str.zfill(2),
                format="%Y%m"
            )
        )

        existing = show["series"].astype(str).unique().tolist()

        # Start with Top-10 countries, optionally add the region aggregate, then:
        #  - remove duplicates while preserving order
        #  - keep only items that actually exist in the data
        order = keep + ([reg] if reg in existing else [])
        order = [s for i, s in enumerate(order) if s in existing and s not in order[:i]]

        # Fallback if something odd happens
        if not order:
            order = sorted(existing)

        show["series"] = pd.Categorical(show["series"], categories=order, ordered=True)

        base = px.colors.qualitative.Plotly
        colors = {s: base[i % len(base)] for i, s in enumerate(order)}
        if reg in order:
            colors[reg] = REGION_COLORS.get(reg, "#222222")  # region line in fixed region color

        # MA (optional)
        y_col = "share"
        view = show.sort_values(["period_dt","series"]).copy()
        if eff_win:
            view = apply_trailing_ma(view, group_cols=["series"], date_col="period_dt", value_col="share", window=eff_win)
            y_col = "share_ma"

        fig = px.line(
            view, x="period_dt", y=y_col, color="series",
            color_discrete_map=colors, category_orders={"series": order},
            template="plotly_white",
            labels={y_col:"Penetration", "period_dt":"Month", "series":"Country/Region"},
            title=make_title(
                "Powertrain Penetration",
                applied_oems=[], applied_brands=[],
                applied_regions=[reg], applied_countries=[],
                region_map=region_map,
                applied_month_range=applied_month_range,
                powertrains=chosen_pts,
                where_override=None,  # title should show the region name
                ma_window=eff_win,
            ),
            custom_data=["share","num","den"]
        )
        if eff_win:
            fig.update_traces(hovertemplate="Month: %{x|%m/%Y}<br>Smoothed: %{y:.1%}<br>Actual: %{customdata[0]:.1%}<br>PT Units: %{customdata[1]:,.0f}<br>Market Units: %{customdata[2]:,.0f}<extra></extra>")
        else:
            fig.update_traces(hovertemplate="Month: %{x|%m/%Y}<br>Penetration: %{y:.1%}<br>PT Units: %{customdata[1]:,.0f}<br>Market Units: %{customdata[2]:,.0f}<extra></extra>")
        fig.update_yaxes(tickformat=".0%")
        fig.update_xaxes(tickformat="%m/%Y")
        fig.update_layout(legend=dict(title="", orientation="h", yanchor="bottom", y=1.12, xanchor="right", x=1))
        st.plotly_chart(_style_fig(fig), use_container_width=True)
        return

    # ---------- CASE C: Multiple Regions  → those regions only ----------
    if multi:
        dfC = scope.copy()
        dfC["region"] = dfC["country"].map(country_to_region)
        dfC = dfC[dfC["region"].isin(applied_regions)].dropna(subset=["region"])

        den = dfC.groupby(["year","month","region"], as_index=False)["total_sales"].sum()
        max_cut = latest_available_yyyymm(dfC)
        den = _redistribute_period_totals_monthly(den, ["region"], "total_sales", max_yyyymm=max_cut)

        num = dfC[dfC["powertrain_simplified"].isin(chosen_pts)].groupby(["year","month","region"], as_index=False)["total_sales"].sum()
        num = _redistribute_period_totals_monthly(num, ["region"], "total_sales", max_yyyymm=max_cut)

        monthly = (den.rename(columns={"total_sales":"den"})
                      .merge(num.rename(columns={"total_sales":"num"}), on=["year","month","region"], how="left")
                      .fillna({"num":0.0}))
        monthly["share"] = np.where(monthly["den"]>0, monthly["num"]/monthly["den"], np.nan)
        monthly = monthly.rename(columns={"region":"series"})

        tmp = monthly.loc[monthly["den"]>0].copy()
        tmp["yyyymm_int"] = _yyyymm(tmp["year"], tmp["month"])
        last_per = tmp.groupby("series")["yyyymm_int"].max()
        if not last_per.empty:
            common_last = int(last_per.min())
            monthly = monthly[_yyyymm(monthly["year"], monthly["month"]) <= common_last]

        if monthly.empty:
            st.info("No penetration data for the selected regions.")
            return

        monthly = monthly.assign(period_dt=pd.to_datetime(monthly["year"].astype(str)+monthly["month"].astype(str).str.zfill(2), format="%Y%m"))
        order = [r for r in applied_regions if r in monthly["series"].unique().tolist()]
        monthly["series"] = pd.Categorical(monthly["series"], categories=order, ordered=True)
        colors = {s: REGION_COLORS.get(s, px.colors.qualitative.Plotly[i % 10]) for i, s in enumerate(order)}

        y_col = "share"
        view = monthly.sort_values(["period_dt","series"]).copy()
        if eff_win:
            view = apply_trailing_ma(view, group_cols=["series"], date_col="period_dt", value_col="share", window=eff_win)
            y_col = "share_ma"

        fig = px.line(
            view, x="period_dt", y=y_col, color="series",
            color_discrete_map=colors, category_orders={"series": order},
            template="plotly_white",
            labels={y_col:"Penetration", "period_dt":"Month", "series":"Region"},
            title=make_title(
                "Powertrain Penetration",
                applied_oems=[], applied_brands=[],
                applied_regions=applied_regions, applied_countries=[],
                region_map=region_map,
                applied_month_range=applied_month_range,
                powertrains=chosen_pts,
                where_override=None,
                ma_window=eff_win,
            ),
            custom_data=["share","num","den"]
        )
        if eff_win:
            fig.update_traces(hovertemplate="Month: %{x|%m/%Y}<br>Smoothed: %{y:.1%}<br>Actual: %{customdata[0]:.1%}<br>PT Units: %{customdata[1]:,.0f}<br>Market Units: %{customdata[2]:,.0f}<extra></extra>")
        else:
            fig.update_traces(hovertemplate="Month: %{x|%m/%Y}<br>Penetration: %{y:.1%}<br>PT Units: %{customdata[1]:,.0f}<br>Market Units: %{customdata[2]:,.0f}<extra></extra>")
        fig.update_yaxes(tickformat=".0%")
        fig.update_xaxes(tickformat="%m/%Y")
        fig.update_layout(legend=dict(title="", orientation="h", yanchor="bottom", y=1.12, xanchor="right", x=1))
        st.plotly_chart(_style_fig(fig), use_container_width=True)


